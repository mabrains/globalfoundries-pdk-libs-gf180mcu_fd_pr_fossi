[flake8]
max-line-length = 88
max-complexity = 18
select = B,C,E,F,W,T4,B9
ignore = E203, E266, E501, W503, F403, F401, W605

exclude =
    # Exclude directories
    .git/,
    .github/,
    docs/,
    models/,
    rules/,
    tech/,
    # There's no value in checking cache directories
    __pycache__/,
    .ipynb_checkpoints,
    # Exlude the existing KLayout-based PCells
    cells/klayout/pymacros/klayout_api_cells/,

